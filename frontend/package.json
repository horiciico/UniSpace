{
  "name": "unispace-frontend-tests",
  "private": true,
  "description": "Unit tests for the frontend scripts. The app itself is plain files served by nginx; nothing here is bundled or served.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
