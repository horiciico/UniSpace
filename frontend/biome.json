{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/*.html"
    ]
  },
  "overrides": [
    {
      "includes": ["i18n/en.js", "i18n/ro.js"],
      "javascript": {
        "formatter": {
          "trailingCommas": "none"
        }
      }
    }
  ]
}
