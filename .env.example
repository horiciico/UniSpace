# Copy to .env and change the values. Never commit .env.

POSTGRES_USER=unispace
POSTGRES_PASSWORD=
POSTGRES_DB=unispace
POSTGRES_PORT=5433

BACKEND_PORT=8000
FRONTEND_PORT=8080
PGADMIN_PORT=8090
PGADMIN_DEFAULT_EMAIL=admin@unispace.com
PGADMIN_DEFAULT_PASSWORD=

GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

SESSION_SECRET_KEY=

# Optional. Set COOKIE_SECURE=true wherever the site is served over HTTPS.
COOKIE_SECURE=false
POST_LOGIN_URL=/

# Admin sign-in (D-021). Plain text for now. Leave both empty to turn the admin sign-in off.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email. EMAIL_BACKEND=console logs each message (the invite link is hidden); smtp sends it.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Leave empty when the server needs no sign-in.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@unispace.local
SMTP_FROM_NAME=UniSpace
SMTP_USE_TLS=true
# The site's address, used to build the links in emails.
APP_BASE_URL=http://localhost:8080
